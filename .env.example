# Instagram professional account feed
# Keep the access token in Vercel Environment Variables; never commit a real token.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v26.0

# Live Google rating shown in the hero, reviews page and schema. Both required;
# without them the site falls back to the static RATING in lib/site.ts.
# Key needs "Places API (New)" enabled; restrict it to that API.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
